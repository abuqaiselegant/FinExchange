
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Side {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password      String
  createdAt     DateTime   @default(now())
}

model Stocks {
  id            Int       @id @default(autoincrement())
  title         String    
  symbol        String     @unique
}